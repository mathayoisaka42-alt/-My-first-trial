# GEMINI_API_KEY: Optional server-side API key if AI features are enabled.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# TIMEZONE: Application standard timezone (Tanzania).
TZ="Africa/Dar_es_Salaam"

# MUSTISO_BOOTSTRAP_PASSCODE: Optional initial institutional administrator passcode.
